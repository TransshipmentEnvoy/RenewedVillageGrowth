SELF_VERSION <- 110             // integer version of the GS, needs to be increased with each release
SELF_MINLOADVERSION <- 110      // minimum integer version of GS that can load this version, increased when major version is increased
SELF_MAJORVERSION <- 11         // main version of the GS, releases with same major version should be saveload compatible
SELF_MINORVERSION <- 0          // minor version of the GS, incremental subreleases of the major version, saveload compatible
SELF_DATE <- "2024-12-31"       // release date
SELF_MAX_TOWNS <- 3000          // maximum number of towns that can be successfully saved in this release
